@model IReadOnlyList<Cliente>
@{
    ViewData["Title"] = "Clientes";
    var buscar = ViewData["Buscar"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo cliente</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="buscar" value="@buscar" class="form-control"
               placeholder="Buscar por cédula, nombres o apellidos" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay clientes registrados@(string.IsNullOrWhiteSpace(buscar) ? "" : " que coincidan con la búsqueda").</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Cédula</th>
                    <th>Cliente</th>
                    <th>Correo</th>
                    <th>Celular</th>
                    <th>Ciudad</th>
                    <th class="text-end">Límite crédito</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Cedula</td>
                        <td>@c.NombreCompleto</td>
                        <td>@(c.Email ?? "-")</td>
                        <td>@(c.Celular ?? "-")</td>
                        <td>@(c.Ciudad ?? "-")</td>
                        <td class="text-end">$ @c.LimiteCredito.ToString("N2")</td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info">Ver</a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Total: @Model.Count cliente(s)</p>
}
