@model Cliente
@{
    ViewData["Title"] = "Eliminar cliente";
}

<h1 class="h3 mb-3">Eliminar cliente</h1>

<div class="alert alert-warning">¿Está seguro de que desea eliminar este cliente? Esta acción no se puede deshacer.</div>

<div class="card">
    <div class="card-header fw-semibold">@Model.NombreCompleto</div>
    <div class="card-body">
        <partial name="_Ficha" model="Model" />
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
